    "After pairing, an iPhone previously paired with this server stops syncing.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配对后，此前与该服务器配对的 iPhone 将停止同步。"
          }
        }
      }
    },
    "After pairing, the data on your server appears here.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与服务器配对后，服务器上的数据将显示在此处。"
          }
        }
      }
    },
    "All": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
